# Шаблон конфигурации. Реальные ключи живут только в .env (не коммитится).
VAULT_PATH='C:/DRON_X_GENIE'
CHROMA_PATH=C:/dron-x-genie/data/chroma_db
DRON_URL=http://localhost:1234/v1/chat/completions
DRON_MODEL=gemma-4-e4b
YANDEX_API_KEY=<your-yandex-api-key>
YANDEX_FOLDER_ID=<your-folder-id>
YANDEX_TEXT_MODEL=yandexgpt/latest
YANDEX_REALTIME_MODEL=speech-realtime-max-tts-live/latest
YANDEX_REALTIME_WSS=wss://ai.api.cloud.yandex.net/v1/realtime
YANDEX_PROMPT_ID=<your-prompt-id>
YANDEX_PROMPT_SERVICE_NAME=ANANISIM OS
YANDEX_MODEL=yandexgpt/latest
GROK_API_KEY=<your-grok-api-key>
NVIDIA_API_KEY=<your-nvidia-api-key>
NOD_API_BASE_URL=https://api.100milionseek.com/v1
NOD_DEEPSEEK_API_KEY=<your-nod-deepseek-api-key>
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-free
